# Le front sert l'appli React et relaie les appels d'API.
# Les noms api-common et api sont fixes : en solution 2, le service api porte
# l'alias réseau api-common, si bien que cette configuration ne change pas.
# ${CLIENT} est substitué au démarrage (envsubst de l'image nginx).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location /api/common/ {
        proxy_pass http://api-common:8000;
    }

    location /api/${CLIENT}/ {
        proxy_pass http://api:8000;
    }

    # Tout autre chemin d'API (par exemple celui d'un autre client) : 404
    location /api/ {
        default_type application/json;
        return 404 '{"message":"Not Found"}';
    }

    # Routage côté navigateur (react-router)
    location / {
        try_files $uri /index.html;
    }
}
